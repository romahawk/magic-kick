NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_USE_EMULATOR=false

# Optional fallback Google Calendar browser OAuth client ID for transient read-only Calendar tokens
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# Optional Firebase Admin SDK for server-side session verification
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Anthropic / Claude AI (server-side only — never expose to the browser)
ANTHROPIC_API_KEY=sk-ant-api03-...
# ADR-017: the AI routes and AI surfaces are parked, default off. Only "true" turns them on.
# Read by the browser and the routes; inlined at build time, so a change needs a rebuild/redeploy.
NEXT_PUBLIC_AI_FEATURES_ENABLED=false

# AI-Business-OS read feed (P7): reads tracked canon files. Fine-grained PAT, romahawk/AI-Business-OS only, Contents: read.
# Server-side only: never prefix with NEXT_PUBLIC_.
AIOS_GITHUB_TOKEN=github_pat_...

# AI-Business-OS write-back (P11 Close day). A separate fine-grained PAT, romahawk/AI-Business-OS only,
# Contents: read and write. Writes only 06_REVIEWS/daily/YYYY-MM-DD.md. Server-side only.
AIOS_GITHUB_WRITE_TOKEN=github_pat_...
# Firebase uid of the only account allowed to write (Roman). Without it, Close day writes nothing.
AIOS_WRITER_UID=
